{
 "1": {
  "dur": 98,
  "text": "인테리어 견적 받다가,\n저 진짜 울 뻔했어요"
 },
 "2": {
  "dur": 106,
  "text": "셀인 카페 다 뒤지고\n동네 업체도 싹 다 돌았거든요"
 },
 "3": {
  "dur": 51,
  "text": "근데 어디는 너무 비싸고"
 },
 "4": {
  "dur": 76,
  "text": "어디는… 솔직히\n믿음이 안 가요"
 },
 "5": {
  "dur": 78,
  "text": "그래서 그냥\n셀프로 하자! 했는데"
 },
 "6": {
  "dur": 61,
  "text": "엄두도 안 나고\n시간도 없고"
 },
 "7": {
  "dur": 75,
  "text": "그러다 검색하다가\n집지니를 알게 됐어요"
 },
 "8": {
  "dur": 135,
  "text": "아파트 이름을 쳤더니\n우리 집 평면도가 딱!"
 },
 "9": {
  "dur": 145,
  "text": "물량이 방마다 다 나오니까\n이 가격이 왜 이 가격인지 알겠더라고요"
 },
 "10": {
  "dur": 109,
  "text": "가양동 사무실에 가서\n자재도 직접 고르고 상담도 받고요"
 },
 "11": {
  "dur": 98,
  "text": "계약은 휴대폰\n전자계약으로 바로 끝"
 },
 "12": {
  "dur": 59,
  "text": "하… 그냥 포기할까 했어요"
 },
 "13": {
  "dur": 68,
  "text": "근데 철거하다가\n일이 터졌어요"
 },
 "14": {
  "dur": 92,
  "text": "추가 비용이요.\n여기서 또 당하나 했는데"
 },
 "15": {
  "dur": 96,
  "text": "왜 드는지 사진이랑 같이\n먼저 다 설명해 주더라고요"
 },
 "16": {
  "dur": 125,
  "text": "공사 일보가 매일 올라오니까\n현장에 안 가도 다 보이고요"
 },
 "17": {
  "dur": 79,
  "text": "역시 13년 넘게 한 데는\n다르구나"
 },
 "18": {
  "dur": 85,
  "text": "그때 포기했으면\n어쩔 뻔했나 싶어요"
 }
}